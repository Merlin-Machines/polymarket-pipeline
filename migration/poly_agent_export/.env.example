POLY_PRIVATE_KEY=replace_with_exported_magic_link_private_key_no_0x_prefix
POLY_SIGNER_ADDRESS=0xYourSignerAddress
POLY_FUNDER_ADDRESS=0xYourFunderOrProxyAddress
POLY_SIGNATURE_TYPE=1

# Optional fallback CLOB API credentials
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# Safety default: keep dry-run enabled unless you intentionally go live
DRY_RUN=1
